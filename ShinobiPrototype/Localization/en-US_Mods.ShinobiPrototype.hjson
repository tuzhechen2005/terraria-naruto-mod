Items: {
	TrainingKunai: {
		DisplayName: Training Kunai
		Tooltip: Basic gear of a Leaf genin; thrown, never used up
	}

	TrainingRasengan: {
		DisplayName: Rasengan (M0 Test)
		Tooltip: Spend 35 chakra to dash forward after a brief windup
	}

	MissionScroll: {
		DisplayName: Old Mission Scroll
		Tooltip:
			'''
			Replaced by the Ninja Handbook;
			turns into one in your inventory
			'''
	}

	MistInsignia: {
		DisplayName: Mist Insignia
		Tooltip: A Mist ninja's token, used to make a challenge scroll
	}

	HakuChallengeScroll: {
		DisplayName: Legacy Haku Challenge Scroll
		Tooltip:
			'''
			Merged into the Wave Country duo battle;
			converts to a Zabuza scroll in your inventory
			'''
	}

	ZabuzaChallengeScroll: {
		DisplayName: Zabuza Challenge Scroll
		Tooltip:
			'''
			Only works around the seaside bridge;
			starts the Wave Country duo battle
			Haku joins when Zabuza is at half health
			Not consumed
			'''
	}

	M0ZabuzaChallengeScroll: {
		DisplayName: Zabuza Test Scroll (M0)
		Tooltip: /m0 test item; summons Zabuza directly
	}

	WaveCountryMedal: {
		DisplayName: Wave Country Medal
		Tooltip: Proof of defeating Zabuza. +2 defense when equipped.
	}

	ExamAdmissionScroll: {
		DisplayName: Chunin Exam Recommendation
		Tooltip:
			'''
			Kakashi's recommendation for the Chunin Exams
			Bring it to Morino Ibiki in the Konoha Academy to sit the first test (the written exam)
			If lost, ask Kakashi for another
			'''
	}

	HeavenScroll: {
		DisplayName: Heaven Scroll
		Tooltip:
			'''
			One of the second test's two scrolls
			Bring it with the Earth Scroll into the tower in the Forest of Death
			'''
	}

	EarthScroll: {
		DisplayName: Earth Scroll
		Tooltip:
			'''
			One of the second test's two scrolls
			Bring it with the Heaven Scroll into the tower in the Forest of Death
			'''
	}

	ChuninHeadband: {
		DisplayName: Chunin Headband
		Tooltip:
			'''
			Proof of passing the Chunin Exams
			+3 defense and +4% melee and magic damage when equipped
			'''
	}

	SnakeSkin: {
		DisplayName: Shed Snake Skin
		Tooltip:
			'''
			Left behind by Orochimaru
			Use it on the jungle surface to draw him out again
			Not consumed
			'''
	}

	NejiChallengeScroll: {
		DisplayName: Neji's Challenge
		Tooltip:
			'''
			Once the finals have begun,
			use it on the stadium field to spar with Neji Hyuga
			Not consumed
			'''
	}

	SoundNinjaToken: {
		DisplayName: Sound Ninja Token
		Tooltip:
			'''
			Use it in the central tower hall of the Forest of Death to fight Dosu again
			Not consumed
			'''
	}

	SandGourd: {
		DisplayName: Sand Gourd
		Tooltip:
			'''
			Use it on the stadium field outside the Leaf's wall to fight Gaara again
			Not consumed
			'''
	}

	SharinganCore1: {
		DisplayName: Sharingan in a Vial (One Tomoe)
		Tooltip:
			'''
			Style core: Sharingan (tier one, one tomoe)
			Substitution logs come back sooner (one every 8 s)
			Style technique [Foresight]: 30 chakra, 20 s cooldown.
			The first hit within 4 s is substituted automatically;
			then +15% damage for 3 s
			Kunai and senbon always crit the enemy seen through
			Only one style core can be worn
			'''
	}

	EightGatesCore: {
		DisplayName: Scroll of the Eight Gates
		Tooltip:
			'''
			Style core: Eight Gates (tier one)
			Taijutsu weapons attack 10% faster
			Style technique [Gate of Opening]: each press opens one more gate (up to three): +10% damage and speed per gate,
			losing 2/4/6 life a second
			Press again at three to close;
			below 20% life they close themselves, then 10 s of fatigue
			20 chakra per gate
			Only one style core can be worn
			'''
	}

	ByakuganCore: {
		DisplayName: Byakugan
		Tooltip:
			'''
			Style core: Byakugan (tier one)
			See nearby enemies
			Melee hits seal chakra points: -4 defense, up to 3 stacks;
			bosses take 5% more damage per stack
			Style technique [Rotation]: 40 chakra, 15 s cooldown.
			Spin for 1 s, cancelling enemy projectiles and throwing back nearby enemies
			Only one style core can be worn
			'''
	}

	TrainingWraps: {
		DisplayName: Training Wraps
		Tooltip:
			'''
			Taijutsu weapon: every punch throws a wave of air pressure,
			harder up close
			Right click [Leaf Whirlwind]: a dash kick,
			briefly invulnerable
			The open Eight Gates make the pressure bigger and carry it further
			'''
	}

	LeeLegWeights: {
		DisplayName: Lee's Leg Weights
		Tooltip:
			'''
			Taijutsu weapon: every punch throws a wave of air pressure,
			harder up close
			Right click [Leaf Whirlwind]: a dash kick,
			briefly invulnerable
			The open Eight Gates make the pressure bigger and carry it further
			'''
	}

	ChakraPill: {
		DisplayName: Soldier Pill
		Tooltip:
			'''
			Restores 40 chakra
			Cannot be eaten again for a short time
			'''
	}

	ChakraCrystal: {
		DisplayName: Chakra Crystal
		Tooltip: Permanently increases maximum chakra by 20 (up to 200)
	}

	NinjaHandbook: {
		DisplayName: Ninja Handbook
		Tooltip:
			'''
			Opens the handbook: current mission, jutsu and chakra
			Craft another from 1 wood if lost
			'''
	}

	DevWings: {
		DisplayName: Developer Wings (M0)
		Tooltip:
			'''
			For development testing; only from /m0 items
			Fly freely in the air with no time limit; the longer you hold a direction, the faster you go
			Jump or Up to rise, Down to sink; release to hover. No fall damage
			'''
	}

	BridgeBlueprint: {
		DisplayName: Tazuna's Blueprint
		Tooltip:
			'''
			Use on a beach facing the sea: the first use outlines the bridge, a second use in place builds it
			One bridge per world; clears natural terrain, but will not build over player-placed blocks
			'''
	}

	WaveBossBag: {
		DisplayName: Treasure Bag (Zabuza and Haku)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	ScrollClone: {
		DisplayName: Clone Jutsu
		Tooltip:
			'''
			Seal scroll, 2 seals: wear it in the 2-seal slot
			Tap the 2-seal key (Z by default) to form the seals and cast: 15 chakra
			Two clones stand beside you for 8 s,
			each taking one hit for you (before any log)
			'''
	}

	ScrollFireball: {
		DisplayName: Fire Style: Fireball Jutsu
		Tooltip:
			'''
			Seal scroll, 4 seals: wear it in the 4-seal slot
			Tap the 4-seal key (X by default) to form the seals and cast: 40 chakra,
			6 s cooldown
			The fireball swells to over a dozen tiles across and rolls slowly through walls,
			scorching small enemies and setting the ground alight
			Into a boss or a big enemy it bursts at once;
			otherwise it bursts at the end
			'''
	}

	ScrollChidori: {
		DisplayName: Chidori
		Tooltip:
			'''
			Seal scroll, 6 seals: wear it in the 6-seal slot
			Tap the 6-seal key (C by default) to form the seals and cast: 60 chakra,
			10 s cooldown
			Lightning gathers in the hand for 1.5 s: you can creep on,
			and enemies close by are struck all the while
			Then a charge of some 40 tiles towards the cursor,
			untouchable, through walls up to 3 tiles thick
			Through every enemy in the way;
			into a boss it stops for a 2.5x blow
			Lightning chakra lingers on the path for 3 s
			'''
	}

	Kubikiribocho: {
		DisplayName: Executioner's Blade
		Tooltip:
			'''
			Zabuza's great sword: slow and heavy, but it hits hard
			Hits sometimes drain a little life
			'''
	}

	Senbon: {
		DisplayName: Senbon
		Tooltip:
			'''
			Throws a fan of three needles; never used up
			Hits sometimes strike a pressure point, slowing the enemy
			'''
	}

	WaterDragonJutsu: {
		DisplayName: Water Style: Water Dragon Jutsu
		Tooltip: Forms seals to raise a water dragon that curls towards nearby enemies and pierces several
	}

	IceMirrorJutsu: {
		DisplayName: Secret Jutsu: Demonic Ice Mirrors
		Tooltip: Summons an ice mirror beside you that throws fans of senbon at enemies
	}

	ZabuzaHeadband: {
		DisplayName: Zabuza's Headband
		Tooltip: A Mist headband worn askew, with a bandage mask
	}

	HakuMask: {
		DisplayName: Haku's Mask
		Tooltip: The mask of a Mist hunter-nin
	}

	ZabuzaTrophy: {
		DisplayName: Zabuza Trophy
		Tooltip: ""
	}

	HakuTrophy: {
		DisplayName: Haku Trophy
		Tooltip: ""
	}
}

NPCs: {
	TazunaBridge: {
		DisplayName: Tazuna the Bridge Builder

		TownNPCMood: {
			Content: Once the bridge is done, I can finally have a proper drink.
			NoHome: This shack is my home. I am not leaving until the bridge is finished.
			FarFromHome: Too far from my bridge. I do not like it.
			LoveSpace: Room enough to stack the bridge stones.
			DislikeCrowded: Too many people. I can hardly breathe.
			HateCrowded: This packed? How is anyone supposed to work!
			LikeBiome: The {BiomeName} is fine, as long as I can see the sea.
			LoveBiome: In the {BiomeName} I can hear the waves. That is home.
			DislikeBiome: The {BiomeName}? Not a drop of water. How do you build a bridge here!
			HateBiome: I cannot stand the {BiomeName}.
			LikeNPC: "{NPCName} is someone you can count on."
			LoveNPC: With {NPCName} beside me, I fear nothing.
			DislikeNPC: "{NPCName} and all that dealing... reminds me of Gato."
			HateNPC: Keep {NPCName} away from my bridge!
			LikeNPC_Princess: What a lovely child {NPCName} is.
			Princess_LovesNPC: I love {NPCName}!
		}
	}

	HakuForest: {
		DisplayName: Herb-Gathering Youth

		TownNPCMood: {
			Content: This forest is quiet, and the herbs grow well.
			NoHome: I do not need a home. Only to be at that person's side.
			FarFromHome: I should go back. That person is waiting for me.
			LoveSpace: The forest is wide open, and the wind is gentle.
			DislikeCrowded: So many people... I prefer quiet places.
			HateCrowded: It is too noisy here. I should go.
			LikeBiome: The {BiomeName} is beautiful.
			LoveBiome: I love the {BiomeName}.
			DislikeBiome: The {BiomeName} reminds me of bad things.
			HateBiome: I do not want to stay in the {BiomeName}.
			LikeNPC: "{NPCName} seems kind."
			LoveNPC: I feel safe with {NPCName}.
			DislikeNPC: "{NPCName}... is a little frightening."
			HateNPC: I do not want to go near {NPCName}.
			LikeNPC_Princess: "{NPCName} is so sweet."
			Princess_LovesNPC: I love {NPCName}!
		}
	}

	DemonBrotherGozu.DisplayName: Demon Brother: Gōzu
	DemonBrotherMeizu.DisplayName: Demon Brother: Meizu

	Tazuna: {
		DisplayName: Bridge Builder
		GivenName: Tazuna

		TownNPCMood: {
			Content: Comfortable enough. Care for a drink?
			NoHome: I build bridges! The least you can do is give me a roof!
			FarFromHome: Too far from my bridge. I do not like it.
			LoveSpace: Room to spare! I could lay out blueprints in here.
			DislikeCrowded: Too many people. I can hardly breathe.
			HateCrowded: This packed? I would rather sleep at the bridgehead!
			LikeBiome: The {BiomeName} is fine, as long as I can see the sea.
			LoveBiome: In the {BiomeName} I can hear the waves. That is home.
			DislikeBiome: The {BiomeName}? Not a drop of water. How do you build a bridge here!
			HateBiome: I cannot stand the {BiomeName}.
			LikeNPC: "{NPCName} is someone you can count on."
			LoveNPC: With {NPCName} beside me, I fear nothing.
			DislikeNPC: "{NPCName} and all that dealing... reminds me of Gato."
			HateNPC: Keep {NPCName} away from my bridge!
			LikeNPC_Princess: What a lovely child {NPCName} is.
			Princess_LovesNPC: I love {NPCName}!
		}
	}

	Kakashi: {
		DisplayName: Leaf Jonin
		GivenName: Kakashi

		TownNPCMood: {
			Content: Not bad here. I can read in peace.
			NoHome: A ninja can sleep outdoors... but a roof would be nice.
			FarFromHome: I am a little far from home. It makes me uneasy.
			LoveSpace: Plenty of room. Good for reading alone.
			DislikeCrowded: A bit crowded. Ninja like it quiet.
			HateCrowded: So crowded there is nowhere left to read.
			LikeBiome: The {BiomeName} reminds me of the Leaf.
			LoveBiome: The {BiomeName} is a fine place.
			DislikeBiome: The {BiomeName}? Too hot. My mask is soaked.
			HateBiome: I really cannot stand the {BiomeName}.
			LikeNPC: "{NPCName} is a good sort."
			LoveNPC: With {NPCName} around, I can relax.
			DislikeNPC: "{NPCName}... is a little loud."
			HateNPC: I cannot stay near {NPCName}.
			LikeNPC_Princess: "{NPCName} has plenty of spirit."
			Princess_LovesNPC: I love {NPCName}!
		}
	}

