Dialogue: {
	PreviewZabuza1: Zabuza: ...So a Leaf brat wants to wade into this too?
	PreviewZabuza2: Zabuza: This bridge will never be finished.
	PreviewHaku: Haku: Master Zabuza, it is not yet time.
	PreviewEnd: The figures in the mist are gone... the Mist ninja are watching this bridge.
	BridgeOpening: Zabuza: Let's settle this here, on this bridge.
	HakuArrive: Haku: Master Zabuza, leave this to me.
	ZabuzaFrenzy: Zabuza: ...Haku. You were a fool to the very end.
	HakuFrenzy: Haku: The reason I exist is gone... then let everything freeze.
	CageTrapped: "{0} was trapped by the ice mirrors"
}

Buffs: {
	ChakraSickness: {
		DisplayName: Pill Cooldown
		Description: Cannot eat another soldier pill yet
	}
}

Tiles.ChakraCrystalTile.MapEntry: Chakra Crystal
Keybinds.Substitution.DisplayName: Substitution Jutsu

Configs: {
	ShinobiClientConfig: {
		DisplayName: Shinobi Settings

		ChakraBarOffsetX: {
			Label: Chakra bar horizontal offset
			Tooltip: Pixels to move the chakra bar right (negative moves it left)
		}

		ChakraBarOffsetY: {
			Label: Chakra bar vertical offset
			Tooltip: Pixels to move the chakra bar down (negative moves it up)
		}

		SeaFogStrength: {
			Label: Sea mist strength (%)
			Tooltip: Thickness of the sea mist around the Wave Country bridge; 0 turns it off, 200 doubles it
		}

		ShowSubstitutionHints: {
			Label: Show Substitution Jutsu hints
			Tooltip: When an enemy hits you, explain how to use Substitution (up to 3 times, none after the first success)
		}
	}
}
