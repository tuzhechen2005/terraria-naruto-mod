Configs: {
	ShinobiClientConfig: {
		DisplayName: 火影模组设置

		ChakraBarOffsetX: {
			Label: 查克拉条水平偏移
			Tooltip: 向右移动查克拉条的像素数（负数向左）
		}

		ChakraBarOffsetY: {
			Label: 查克拉条垂直偏移
			Tooltip: 向下移动查克拉条的像素数（负数向上）
		}

		SeaFogStrength: {
			Label: 海边雾浓度（%）
			Tooltip:
				'''
				波之国大桥附近海雾的浓度；0 为关闭，
				200 为加倍
				'''
		}

		RegionBackgrounds: {
			Label: 火影地区背景
			Tooltip:
				'''
				在木叶、波之国、砂隐等地区用火影风格的地表背景；
				关闭则使用原版背景
				'''
		}

		QuestTracker: {
			Label: 任务追踪
			Tooltip:
