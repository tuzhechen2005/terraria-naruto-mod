Items: {
	TrainingKunai: {
		DisplayName: 训练苦无
		Tooltip: 木叶下忍的基础忍具，投掷后不消耗
	}

	TrainingRasengan: {
		DisplayName: 螺旋丸（M0 测试）
		Tooltip: 消耗 35 查克拉，短暂蓄力后贴身突进
	}

	MissionScroll: {
		DisplayName: 旧版任务卷轴
		Tooltip: 已由忍者手册取代；放入背包后自动转换
	}

	MistInsignia: {
		DisplayName: 雾隐标记
		Tooltip: 雾隐忍者的身份标记；可用于制作挑战卷轴
	}

	HakuChallengeScroll: {
		DisplayName: 旧版白的挑战卷轴
		Tooltip: 已合并为波之国双首领战；放入背包后自动转换为再不斩挑战卷轴
	}

	ZabuzaChallengeScroll: {
		DisplayName: 再不斩的挑战卷轴
		Tooltip: 只能在海边的大桥一带使用，召唤波之国双首领战\n再不斩半血后白将协战\n不会被消耗
	}

	M0ZabuzaChallengeScroll: {
		DisplayName: 再不斩测试卷轴（M0）
		Tooltip: /m0 测试专用；直接召唤再不斩
	}

	WaveCountryMedal: {
		DisplayName: 波之国功绩牌
		Tooltip: 击败再不斩的证明；装备后防御 +2
	}

	ExamAdmissionScroll: {
		DisplayName: 中忍考试推荐书
		Tooltip: 卡卡西推荐你参加中忍考试的推荐书\n带着它去木叶的忍者学校，找主考官森乃伊比喜参加第一试（笔试）\n遗失了可以再找卡卡西要
	}

	HeavenScroll: {
		DisplayName: 天之卷
		Tooltip: 中忍考试第二试的卷轴之一\n与地之卷一起带进死亡森林的中央塔
	}

	EarthScroll: {
		DisplayName: 地之卷
		Tooltip: 中忍考试第二试的卷轴之一\n与天之卷一起带进死亡森林的中央塔
	}

	ChuninHeadband: {
		DisplayName: 中忍护额
		Tooltip: 通过中忍考试的证明\n装备后防御 +3，近战与魔法伤害 +4%
	}

	SnakeSkin: {
		DisplayName: 蛇的蜕皮
		Tooltip: 大蛇丸留下的蛇蜕\n在丛林的地表使用，把他再引出来\n不会被消耗
	}

	NejiChallengeScroll: {
		DisplayName: 宁次的切磋书
		Tooltip: 正式赛开始后，在考试会场的场地上使用，与日向宁次切磋\n不会被消耗
	}

	SoundNinjaToken: {
		DisplayName: 音忍的对战牌
		Tooltip: 在死亡森林中央塔的大厅使用，与音忍多斯再战\n不会被消耗
	}

	SandGourd: {
		DisplayName: 砂隐的葫芦
		Tooltip: 在木叶城墙外考试会场的场地上使用，与我爱罗再战\n不会被消耗
	}

	SharinganCore1: {
		DisplayName: 装在试管里的写轮眼（一勾玉）
		Tooltip: 流派核心·写轮眼（第一阶·一勾玉）\n替身木头恢复更快（8 秒一根）\n流派奥义【看破】：30 查克拉，冷却 20 秒。4 秒内受到的第一次攻击自动替身，成功后 3 秒内伤害 +15%\n苦无、千本命中被看破的敌人必定暴击\n一次只能装备一个流派核心
	}

	EightGatesCore: {
		DisplayName: 八门遁甲之卷
		Tooltip: 流派核心·八门（第一阶）\n体术武器攻速 +10%\n流派奥义【开门】：每按一次多开一门（最多三门），每门伤害与移速 +10%，按门数每秒失去 2/4/6 生命\n三门时再按关门；生命低于 20% 自动关门，之后 10 秒疲劳\n每开一门耗 20 查克拉\n一次只能装备一个流派核心
	}

	ByakuganCore: {
		DisplayName: 白眼
		Tooltip: 流派核心·白眼（第一阶）\n看得见附近的敌人\n近战命中点穴：防御 -4，最多 3 层；Boss 每层多受 5% 伤害\n流派奥义【八卦掌·回天】：40 查克拉，冷却 15 秒。旋转 1 秒，抵消敌方弹幕并弹开近身敌人\n一次只能装备一个流派核心
	}

	TrainingWraps: {
		DisplayName: 训练用绷带
		Tooltip: 体术武器：每一拳打出一道风压，贴身时伤害更高\n右键【木叶旋风】：冲刺踢，冲刺中短暂无敌\n八门打开时风压更大、飞得更远
	}

	LeeLegWeights: {
		DisplayName: 小李的负重护腿
		Tooltip: 体术武器：每一拳打出一道风压，贴身时伤害更高\n右键【木叶旋风】：冲刺踢，冲刺中短暂无敌\n八门打开时风压更大、飞得更远
	}

	ChakraPill: {
		DisplayName: 兵粮丸
		Tooltip:
			'''
			立即回复 40 查克拉
			之后短时间内无法再次服用
			'''
	}

	ChakraCrystal: {
		DisplayName: 查克拉结晶
		Tooltip: 永久提升 20 查克拉上限（最多 200）
	}

	NinjaHandbook: {
		DisplayName: 忍者手册
		Tooltip:
			'''
			使用后打开手册：当前任务、忍术用法、查克拉说明
			丢失后可用 1 木材重新制作
			'''
	}

	DevWings: {
		DisplayName: 开发者之翼（M0）
		Tooltip:
			'''
			开发测试专用，只能通过 /m0 items 获得
			空中按方向键自由飞行，无飞行时间限制；按住越久飞得越快，松开悬停
			跳跃或上键升高，下键下降；免疫摔落伤害
			'''
	}

	BridgeBlueprint: {
		DisplayName: 达兹纳的施工图
		Tooltip:
			'''
			站在海滩上面朝大海使用：第一次显示大桥轮廓，原地再用一次开始建造
			每个世界只能建一座桥；会清除自然地形，遇到自建方块则不会建造
			'''
	}

	WaveBossBag: {
		DisplayName: 宝藏袋（再不斩与白）
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	Kubikiribocho: {
		DisplayName: 斩首大刀
		Tooltip: 再不斩的巨刀，挥动沉重但威力巨大\n命中时有概率吸取少量生命
	}

	Senbon: {
		DisplayName: 千本
		Tooltip: 一次扇形掷出三根千本，不消耗\n命中时有概率刺中穴位，使敌人减速
	}

	WaterDragonJutsu: {
		DisplayName: 水遁·水龙弹之术
		Tooltip: 结印唤出水龙，追向附近的敌人并穿透多个目标
	}

	IceMirrorJutsu: {
		DisplayName: 秘术·魔镜冰晶
		Tooltip: 在身旁召唤一面冰镜，向敌人扇形掷出千本
	}

	ZabuzaHeadband: {
		DisplayName: 再不斩护额
		Tooltip: 歪戴的雾隐护额与绷带面罩
	}

	HakuMask: {
		DisplayName: 白的面具
		Tooltip: 雾隐追杀部队的面具
	}

	ZabuzaTrophy: {
		DisplayName: 再不斩奖杯
		Tooltip: ""
	}

	HakuTrophy: {
		DisplayName: 白奖杯
		Tooltip: ""
	}
}

NPCs: {
	TazunaBridge: {
		DisplayName: 造桥工 达兹纳

		TownNPCMood: {
			Content: 等桥修好了，我就能好好喝一杯了。
			NoHome: 这破屋子就是我的家，桥不修好我哪儿也不去。
			FarFromHome: 离我的桥太远了，心里不踏实。
			LoveSpace: 地方够大，堆得下造桥的石料。
			DislikeCrowded: 人太多了，挤得我喘不过气。
			HateCrowded: 挤成这样，还怎么干活！
			LikeBiome: "{BiomeName}不错，看得见海就好。"
			LoveBiome: 住在{BiomeName}，能听见海浪声。这才叫家啊。
			DislikeBiome: "{BiomeName}？连一滴水都没有，怎么造桥！"
			HateBiome: 我受不了{BiomeName}。
			LikeNPC: "{NPCName}是个靠得住的人。"
			LoveNPC: 有{NPCName}在身边，我什么都不怕。
			DislikeNPC: "{NPCName}那副做生意的样子……让我想起卡多。"
			HateNPC: 别让{NPCName}靠近我的桥！
			LikeNPC_Princess: "{NPCName}这孩子真讨人喜欢。"
			Princess_LovesNPC: 我很喜欢{NPCName}！
		}
	}

	HakuForest: {
		DisplayName: 采药的少年

		TownNPCMood: {
			Content: 这片林子很安静，草药也长得好。
			NoHome: 我不需要家。只要能待在那个人身边就好。
			FarFromHome: 我该回去了，那个人还在等我。
			LoveSpace: 林子里很宽敞，风也很舒服。
			DislikeCrowded: 人太多了……我还是喜欢安静的地方。
			HateCrowded: 这里太吵了，我该走了。
			LikeBiome: "{BiomeName}很美。"
			LoveBiome: 我很喜欢{BiomeName}。
			DislikeBiome: "{BiomeName}让我想起不好的事。"
			HateBiome: 我不想待在{BiomeName}。
			LikeNPC: "{NPCName}看起来是个温柔的人。"
			LoveNPC: 和{NPCName}在一起，很安心。
			DislikeNPC: "{NPCName}……有点可怕。"
			HateNPC: 我不想靠近{NPCName}。
			LikeNPC_Princess: "{NPCName}真可爱。"
			Princess_LovesNPC: 我很喜欢{NPCName}！
		}
	}

	DemonBrotherGozu.DisplayName: 鬼之兄弟·伽乌斯
	DemonBrotherMeizu.DisplayName: 鬼之兄弟·美伊兹

	Tazuna: {
		DisplayName: 造桥工
		GivenName: 达兹纳

		TownNPCMood: {
			Content: 住得挺舒服。来，喝一杯？
			NoHome: 我可是造桥的，总得给我个屋顶吧！
			FarFromHome: 离我的桥太远了，心里不踏实。
			LoveSpace: 宽敞！这么大的地方，都能画施工图了。
			DislikeCrowded: 人太多了，挤得我喘不过气。
			HateCrowded: 挤成这样，我宁可回桥头去住！
			LikeBiome: "{BiomeName}不错，看得见海就好。"
			LoveBiome: 住在{BiomeName}，能听见海浪声。这才叫家啊。
			DislikeBiome: "{BiomeName}？连一滴水都没有，怎么造桥！"
			HateBiome: 我受不了{BiomeName}。
			LikeNPC: "{NPCName}是个靠得住的人。"
			LoveNPC: 有{NPCName}在身边，我什么都不怕。
			DislikeNPC: "{NPCName}那副做生意的样子……让我想起卡多。"
			HateNPC: 别让{NPCName}靠近我的桥！
			LikeNPC_Princess: "{NPCName}这孩子真讨人喜欢。"
			Princess_LovesNPC: 我很喜欢{NPCName}！
		}
	}

	Kakashi: {
		DisplayName: 木叶上忍
		GivenName: 卡卡西

		TownNPCMood: {
			Content: 嗯，住得还不错。可以安心看书了。
			NoHome: 忍者露宿也不是不行……不过有个屋顶会更好。
			FarFromHome: 离家太远了，有点不放心。
			LoveSpace: 地方宽敞，适合一个人静静看书。
			DislikeCrowded: 人有点多。忍者还是喜欢清静。
			HateCrowded: 这么挤，连看书的地方都没有了。
			LikeBiome: "{BiomeName}让我想起木叶。"
			LoveBiome: "{BiomeName}真是个好地方。"
			DislikeBiome: "{BiomeName}？……太热了，面罩里都是汗。"
			HateBiome: 我实在受不了{BiomeName}。
			LikeNPC: "{NPCName}是个不错的人。"
			LoveNPC: 有{NPCName}在，我很放心。
			DislikeNPC: "{NPCName}……有点吵。"
			HateNPC: 我没法和{NPCName}待在一起。
			LikeNPC_Princess: "{NPCName}很有精神啊。"
			Princess_LovesNPC: 我很喜欢{NPCName}！
		}
	}

