Items: {
	TrainingKunai: {
		DisplayName: 训练苦无
		Tooltip: 木叶下忍的基础忍具
	}

	TrainingRasengan: {
		DisplayName: 螺旋丸（M0 测试）
		Tooltip: 消耗 35 查克拉，短暂蓄力后贴身突进
	}

	MissionScroll: {
		DisplayName: 旧版任务卷轴
		Tooltip: 已由忍者手册取代；放入背包后自动转换
	}

	MistInsignia: {
		DisplayName: 雾隐标记
		Tooltip: 雾隐侦察兵留下的身份标记；可用于制作挑战卷轴
	}

	HakuChallengeScroll: {
		DisplayName: 旧版白的挑战卷轴
		Tooltip: 已合并为波之国双首领战；放入背包后自动转换为再不斩挑战卷轴
	}

	ZabuzaChallengeScroll: {
		DisplayName: 再不斩的挑战卷轴
		Tooltip: 在开阔地使用，召唤波之国双首领战；半血后白将协战；不会被消耗
	}

	M0ZabuzaChallengeScroll: {
		DisplayName: 再不斩测试卷轴（M0）
		Tooltip: /m0 测试专用；直接召唤再不斩
	}

	WaveCountryMedal: {
		DisplayName: 波之国功绩牌
		Tooltip: 击败再不斩的证明；装备后防御 +2
	}

	ExamAdmissionScroll: {
		DisplayName: 中忍考试报名书
		Tooltip: 完成波之国篇后使用，报名丛林试炼；可用木材与铁锭或铅锭补做
	}

	HeavenScroll: {
		DisplayName: 天之卷轴
		Tooltip: 丛林地表考生持有；与地之卷轴一起制作预选赛挑战书
	}

	EarthScroll: {
		DisplayName: 地之卷轴
		Tooltip: 地下丛林考生持有；与天之卷轴一起制作预选赛挑战书
	}

	ArenaChallengeScroll: {
		DisplayName: 中忍预选赛挑战书
		Tooltip: 在开阔地召唤砂隐考生；不会被消耗
	}

	ChuninHeadband: {
		DisplayName: 中忍护额
		Tooltip: 中忍考试预选赛奖励；装备后防御 +3，近战与忍术伤害 +4%
	}

	ChakraPill: {
		DisplayName: 兵粮丸
		Tooltip:
			'''
			立即回复 40 查克拉
			之后短时间内无法再次服用
			'''
	}

	ChakraCrystal: {
		DisplayName: 查克拉结晶
		Tooltip: 永久提升 20 查克拉上限（最多 200）
	}

	NinjaHandbook: {
		DisplayName: 忍者手册
		Tooltip:
			'''
			使用后打开手册：当前任务、忍术用法、查克拉说明
			丢失后可用 1 木材重新制作
			'''
	}

	DevWings: {
		DisplayName: 开发者之翼（M0）
		Tooltip:
			'''
			开发测试专用，只能通过 /m0 items 获得
			空中按方向键自由飞行，无飞行时间限制；按住越久飞得越快，松开悬停
			跳跃或上键升高，下键下降；免疫摔落伤害
			'''
	}

	BridgeBlueprint: {
		DisplayName: 达兹纳的施工图
		Tooltip:
			'''
			站在海滩上面朝大海使用：第一次显示大桥轮廓，原地再用一次开始建造
			每个世界只能建一座桥；会清除自然地形，遇到自建方块则不会建造
			'''
	}
}

