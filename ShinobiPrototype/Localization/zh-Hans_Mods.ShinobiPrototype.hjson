Items: {
	TrainingKunai: {
		DisplayName: 训练苦无
		Tooltip: 命中敌人时回复少量查克拉
	}

	TrainingRasengan: {
		DisplayName: 螺旋丸（M0 测试）
		Tooltip: 消耗 35 查克拉，短暂蓄力后贴身突进
	}

	ChakraPalm: {
		DisplayName: 查克拉冲击
		Tooltip: 消耗 18 查克拉，短暂蓄力后贴身突进
	}

	MissionScroll: {
		DisplayName: 下忍任务卷轴
		Tooltip: 使用后查看探索线索与独立进度；丢失后可用 1 木材重新制作
	}

	MistInsignia: {
		DisplayName: 雾隐标记
		Tooltip: 雾隐侦察兵留下的身份标记；可用于制作挑战卷轴
	}

	HakuChallengeScroll: {
		DisplayName: 旧版白的挑战卷轴
		Tooltip: 已合并为波之国双首领战；放入背包后自动转换为再不斩挑战卷轴
	}

	ZabuzaChallengeScroll: {
		DisplayName: 再不斩的挑战卷轴
		Tooltip: 在开阔地使用，召唤波之国双首领战；半血后白将协战；不会被消耗
	}

	M0ZabuzaChallengeScroll: {
		DisplayName: 再不斩测试卷轴（M0）
		Tooltip: /m0 测试专用；直接召唤再不斩
	}

	ElementalTechnique: {
		DisplayName: 五遁基础忍术
		Tooltip: 左键施放当前已学忍术，右键切换已学属性；每次消耗 22 查克拉
	}

	NinjaProfileScroll: {
		DisplayName: 忍者身份卷轴
		Tooltip: 左键选择战斗倾向，右键选择查克拉性质；训练完成后锁定；可用 1 木材补做
	}

	NinjutsuManual: {
		DisplayName: 忍术研习手册
		Tooltip: 左键切换目标属性，右键消耗木材和坠星学习；跨系需要更多坠星
	}

	WaveCountryMedal: {
		DisplayName: 波之国功绩牌
		Tooltip: 击败再不斩的证明；装备后防御 +2
	}

	ExamAdmissionScroll: {
		DisplayName: 中忍考试报名书
		Tooltip: 完成波之国篇后使用，报名丛林试炼；可用木材与铁锭或铅锭补做
	}

	HeavenScroll: {
		DisplayName: 天之卷轴
		Tooltip: 丛林地表考生持有；与地之卷轴一起制作预选赛挑战书
	}

	EarthScroll: {
		DisplayName: 地之卷轴
		Tooltip: 地下丛林考生持有；与天之卷轴一起制作预选赛挑战书
	}

	ArenaChallengeScroll: {
		DisplayName: 中忍预选赛挑战书
		Tooltip: 在开阔地召唤砂隐考生；不会被消耗
	}

	ChuninHeadband: {
		DisplayName: 中忍护额
		Tooltip: 中忍考试预选赛奖励；装备后防御 +3，近战与忍术伤害 +4%
	}
}

